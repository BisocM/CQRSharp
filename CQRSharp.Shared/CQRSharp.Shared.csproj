<Project Sdk="Microsoft.NET.Sdk">

    <!-- Build Configuration -->
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;netstandard2.0</TargetFrameworks>
        <LangVersion>default</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
    </PropertyGroup>

    <!-- NuGet Package Metadata -->
    <PropertyGroup>
        <Title>A lightweight, extensible, and attribute-driven CQRS framework for .NET applications (Shared Library).</Title>
        <Authors>$(AssemblyName)</Authors>
        <Company>BisocM</Company>
        <PackageProjectUrl>https://cqrsharp.bisocm.org</PackageProjectUrl>
        <PackageIcon>CQRSharp_Icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/BisocM/CQRSharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>CQRS</PackageTags>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <Version>2.2.3</Version>
        <Description>Contains shared abstractions and common types for CQRSharp. This library underpins the rest of the CQRSharp framework.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>
            🚀 Release Notes for 2.2.1

            🔧 Roslyn Generators

		Each request not contains more information regarding compile-time execution - including RequestMetadata. Now, you can retrieve more runtime-specific information that will allow for more fine-grained control over program execution, if desired.
		Each request completion notification now also contains data about the context of the executed request and its metadata.

            📂 Breaking Changes?
		Removed ExecutionLoggingBehavior due to AoT incompatibility and redundancy. In future versions, all behaviors will be moved to a separate package.</PackageReleaseNotes>
    </PropertyGroup>

    <!-- Package Assets -->
    <ItemGroup>
        <None Include="..\CQRSharp_Icon.png">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\LICENSE">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
            <Link>LICENSE</Link>
        </None>
        <None Include="..\README.md">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>