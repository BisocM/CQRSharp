<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Dispatch-overhead benchmarks: CQRSharp vs MediatR. Deliberately NOT part of CQRSharp.sln — it pulls
        a third-party mediator that the library itself must never depend on, and it is run on demand, not in CI
        (see benchmarks/README.md for the command).

        MediatR is pinned to 12.5.0, the last release under the Apache-2.0 license (13.0+ is commercially licensed).
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet"/>
        <PackageReference Include="MediatR"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CQRSharp.Core\CQRSharp.Core.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.Generators\CQRSharp.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
