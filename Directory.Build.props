<Project>

    <!--
        Shared package metadata and build settings for all CQRSharp projects. Project-specific values
        (PackageId, Title, Description, PackageTags, TargetFrameworks, PackageReleaseNotes) remain in each project.
    -->
    <PropertyGroup>
        <Authors>BisocM</Authors>
        <Company>BisocM</Company>
        <Version>4.0.2</Version>
        <PackageProjectUrl>https://cqrsharp.bisocm.org</PackageProjectUrl>
        <RepositoryUrl>https://github.com/BisocM/CQRSharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageIcon>CQRSharp_Icon.png</PackageIcon>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- dotnet pack drops the packages in the git-ignored repo-root .nupkgs; the publish workflow packs here then pushes. -->
        <PackageOutputPath>$(MSBuildThisFileDirectory).nupkgs</PackageOutputPath>

        <!-- Deterministic, source-linked, symbol-bearing packages. -->
        <Deterministic>true</Deterministic>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- Pack the icon, license, and README into every CQRSharp package (inert for non-packable projects). -->
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)Assets/CQRSharp_Icon.png" Pack="true" PackagePath="\" Visible="false"/>
        <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false"/>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

    <!--
        Surface the multi-assembly composition-root signal to the CQRSharp source generator. The generator emits the
        global AddCqrsGenerated/AddGenerated entry points (which wire every module in the reference graph) only in the
        composition root: an executable by default, or any project that sets <CQRSharpCompositionRoot>true</...>. The
        OutputType is exposed so the generator can apply the executable default. (For package consumers the same two
        properties are exposed via the meta-package's buildTransitive props.)
    -->
    <ItemGroup>
        <CompilerVisibleProperty Include="CQRSharpCompositionRoot"/>
        <CompilerVisibleProperty Include="OutputType"/>
    </ItemGroup>

</Project>
