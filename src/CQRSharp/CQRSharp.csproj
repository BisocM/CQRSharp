<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(CQRSharpTargetFrameworks)</TargetFrameworks>

        <IncludeBuildOutput>false</IncludeBuildOutput>

        <PackageId>CQRSharp</PackageId>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <NoWarn>$(NoWarn);CS2008;NU5128</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Meta-package: no lib output, so no symbol package. -->
        <IncludeSymbols>false</IncludeSymbols>
        <Title>CQRSharp: a source-generated, Native-AOT-safe CQRS framework for .NET.</Title>
        <PackageTags>CQRS;CQRSharp;NativeAOT;SourceGenerator</PackageTags>
        <Description>A CQRS framework for .NET 8/9/10 that is wired at compile time. A Roslyn source generator emits the command, query, stream and notification dispatch and the handler registrations as plain C#, so there is no runtime reflection and the whole thing is trimming- and Native-AOT-safe; analyzers catch wiring mistakes as you type. Pipeline behaviors (validation and exception handling on by default; logging, retries, timeouts, rate limiting, idempotency and unit of work opt-in) and a transactional outbox come behind one fluent builder. Install this meta-package for the full setup: the contracts, the runtime, the pipeline behaviors, the source generator and the analyzers.</Description>
        <PackageReleaseNotes>
            Version 5.0.0, a major release with breaking changes. Application code uses the CQRSharp and CQRSharp.Pipelines namespaces (global usings with ImplicitUsings); store and unit-of-work implementations add CQRSharp.Persistence.
            Handler interfaces take no context type argument, AddCqrsGenerated is configured through its builder and registers validation and exception handling in both forms (opt out with UseValidation(false) / UseExceptionHandling(false)), and startup validation runs only when you call ValidateOnStart().
            Rebuild every assembly that runs the source generator, and drain the outbox with 4.x processors before upgrading.
            See https://github.com/BisocM/CQRSharp/blob/Release/CHANGELOG.md for the full notes and the upgrade steps from 4.2.1.
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CQRSharp.Core\CQRSharp.Core.csproj"/>
        <ProjectReference Include="..\CQRSharp.Pipelines\CQRSharp.Pipelines.csproj"/>
        <ProjectReference Include="..\CQRSharp.Generators\CQRSharp.Generators.csproj"
                          PrivateAssets="all"/>
        <ProjectReference Include="..\CQRSharp.Abstractions\CQRSharp.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!--
            The source generator ships in this package only: a project that declares handlers references the
            meta-package, and the generator is what registers them. The analyzers are not repeated here; they ship in
            CQRSharp.Abstractions and reach the meta-package's consumers through its dependencies (see
            src/Directory.Build.props).
        -->
        <None Include="..\CQRSharp.Generators\bin\$(Configuration)\netstandard2.0\CQRSharp.Generators.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Global usings for the authoring surface (CQRSharp and CQRSharp.Pipelines), so a consumer writes handlers
             without importing them. See build/CQRSharp.props. -->
        <None Include="build/CQRSharp.props" Pack="true" PackagePath="buildTransitive/CQRSharp.props" Visible="false"/>
    </ItemGroup>

</Project>
