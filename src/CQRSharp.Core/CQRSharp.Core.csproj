<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(CQRSharpTargetFrameworks)</TargetFrameworks>
        <LangVersion>default</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Turns on the trim, AOT and single-file analyzers, whose warnings the -warnaserror gate makes errors. -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <PackageTags>CQRS;CQRSharp;NativeAOT</PackageTags>
        <Title>The CQRSharp runtime: source-generated, Native-AOT-safe CQRS dispatch for .NET.</Title>
        <Description>The CQRSharp runtime: the ICqrsDispatcher facade, pipeline execution, notification publishing, background task queue and transactional outbox processing, distributed-tracing hooks, health checks, and the source-generated, Native-AOT-friendly handler registries.</Description>
        <PackageReleaseNotes>
            Version 5.0.0 (breaking). The outbox delivers per handler and in order per partition key, under leases, with an inbox, dead-letter operations, backlog gauges and the AddCqrsOutbox() health check; a request's notifications are stored when it succeeds and discarded when it fails.
            Notifications reach the handlers of their runtime type. A new CQRSharp meter joins renamed span attributes (every name is on CqrsTelemetry), and every log line has an event id.
            The background queue drains within ShutdownTimeout and reports refused work as BackgroundTaskRejectedException. Core no longer depends on Microsoft.Extensions.Hosting.
            See https://github.com/BisocM/CQRSharp/blob/Release/CHANGELOG.md for the full notes and the upgrade steps from 4.2.1.
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CQRSharp.Abstractions\CQRSharp.Abstractions.csproj"/>
    </ItemGroup>

    <!--
        Only the abstractions the runtime programs against: the application brings its own host, container and logging
        providers. Microsoft.Extensions.Logging (not only its abstractions) is for the AddLogging() call in AddCqrs.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>CQRSharp.Tests</_Parameter1>
        </AssemblyAttribute>
        <!-- The fluent builder (CQRSharp.Pipelines) reads/applies the internal state of the Core store-builders
             (OutboxStoreBuilder/IdempotencyStoreBuilder) when wiring UseOutbox/UseIdempotency. -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>CQRSharp.Pipelines</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
