<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(CQRSharpTargetFrameworks)</TargetFrameworks>
        <LangVersion>default</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Turns on the trim, AOT and single-file analyzers, whose warnings the -warnaserror gate makes errors. -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <PackageTags>CQRS;CQRSharp;NativeAOT</PackageTags>
        <Title>The CQRSharp runtime: source-generated, Native-AOT-safe CQRS dispatch for .NET.</Title>
        <Description>The CQRSharp runtime: the ICqrsDispatcher facade, pipeline execution, notification publishing, background task queue and transactional outbox processing, distributed-tracing hooks, health checks, and the source-generated, Native-AOT-friendly handler registries.</Description>
        <PackageReleaseNotes>
            Version 5.1.0. ICqrsDispatcher.PublishAt / PublishAfter publish a durable notification for delivery once it is due, through the outbox, as if published then; they fail rather than deliver in-process when the outbox cannot hold it. The in-memory store can schedule; the cqrsharp.outbox.scheduled gauge and the health check's scheduled datum count what waits.
            A custom-context dispatch reads the application's clock once instead of twice.
            See https://github.com/BisocM/CQRSharp/blob/v$(Version)/CHANGELOG.md for the full notes; upgrading from 5.0 needs no code or schema change.
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CQRSharp.Abstractions\CQRSharp.Abstractions.csproj"/>
    </ItemGroup>

    <!--
        Only the abstractions the runtime programs against: the application brings its own host, container and logging
        providers. Microsoft.Extensions.Logging (not only its abstractions) is for the AddLogging() call in AddCqrs.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>CQRSharp.Tests</_Parameter1>
        </AssemblyAttribute>
        <!-- The fluent builder (CQRSharp.Pipelines) reads/applies the internal state of the Core store-builders
             (OutboxStoreBuilder/IdempotencyStoreBuilder) when wiring UseOutbox/UseIdempotency. -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>CQRSharp.Pipelines</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
