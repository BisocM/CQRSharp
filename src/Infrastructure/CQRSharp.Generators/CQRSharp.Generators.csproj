<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>CQRSharp.Generators</RootNamespace>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <PublishAot>false</PublishAot>
        <IncludeBuildOutput>false</IncludeBuildOutput>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageOutputPath>$(MSBuildThisFileDirectory)..\.nupkgs</PackageOutputPath>

        <PackageIcon>CQRSharp_Icon.png</PackageIcon>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <Version>3.0.0</Version>
        <Authors>BisocM</Authors>
        <Title>CQRSharp Source Generators</Title>
        <Description>Analyzer-only source generators for CQRSharp that generate handler registrations, AOT hints, and outbox notification serialization.</Description>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>

    </ItemGroup>

    <ItemGroup>
        <!-- Avoid runtime dependencies for analyzer load; include shared constants as source. -->
        <Compile Include="..\..\Domain\CQRSharp.Abstractions\SourceGeneration\TypeStrings.cs"
                 Link="SourceGeneration\TypeStrings.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\..\CQRSharp_Icon.png" Pack="true" PackagePath="\"/>
        <None Include="..\..\..\LICENSE" Pack="true" PackagePath="\"/>
        <None Include="..\..\..\NUGET_README.txt" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all"/>
    </ItemGroup>

</Project>
