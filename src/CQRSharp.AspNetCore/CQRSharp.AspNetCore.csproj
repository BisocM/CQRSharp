<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(CQRSharpTargetFrameworks)</TargetFrameworks>
        <LangVersion>default</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Turns on the trim, AOT and single-file analyzers, whose warnings the -warnaserror gate makes errors. -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>CQRSharp.AspNetCore</PackageId>
        <PackageTags>CQRS;CQRSharp;AspNetCore;MinimalApi;ProblemDetails;Idempotency;NativeAOT</PackageTags>
        <Title>ASP.NET Core integration for CQRSharp: result mapping, ProblemDetails exception mapping, and Idempotency-Key.</Title>
        <Description>A Native-AOT-compatible ASP.NET Core integration for CQRSharp with no MVC dependency. Maps CommandResult and CommandResult&lt;T&gt; to minimal-API IResult responses (200/201/204, or an RFC 7807 ProblemDetails whose status follows the result's error kind), registers an IExceptionHandler that turns the exceptions a dispatch throws (validation, duplicate request, idempotency key mismatch, rate limit, timeout, queue refusal) into ProblemDetails responses through the host's IProblemDetailsService, and reads and validates the Idempotency-Key request header.</Description>
        <PackageReleaseNotes>
            Version 5.0.0. First release: AddCqrsProblemDetails(), ToHttpResult() / ToCreatedHttpResult(...) and GetIdempotencyKey() / TryGetIdempotencyKey().
            See https://github.com/BisocM/CQRSharp/blob/v$(Version)/CHANGELOG.md for the full notes and the upgrade steps from 4.2.1.
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CQRSharp.Abstractions\CQRSharp.Abstractions.csproj"/>
        <!-- Referenced for RateLimitExceededException, which lives with the rate-limiting behavior that throws it. -->
        <ProjectReference Include="..\CQRSharp.Pipelines\CQRSharp.Pipelines.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>CQRSharp.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
