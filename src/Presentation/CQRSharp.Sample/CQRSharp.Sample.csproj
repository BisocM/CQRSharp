<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>CQRSharp.Sample</RootNamespace>
        <LangVersion>default</LangVersion>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <PublishAot>true</PublishAot>
        <RunAnalyzers>true</RunAnalyzers>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '9.0.100'))">
        <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0.100'))">
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Domain\CQRSharp.Core\CQRSharp.Core.csproj"/>
        <ProjectReference Include="..\..\Application\CQRSharp.Pipelines\CQRSharp.Pipelines.csproj"/>
        <!-- A second handler-bearing assembly so the Native AOT publish exercises CQRSharp's multi-assembly codegen
             path (its module is wired by this app's AddCqrsGenerated; see SampleHostedService.RunExternalModuleTestAsync). -->
        <ProjectReference Include="..\CQRSharp.Sample.ExternalModule\CQRSharp.Sample.ExternalModule.csproj"/>
        <!-- The Redis integration is referenced only so the NativeAOT Sample publish exercises its IL (the publish
             workflow greps the published output for Redis types). It is registered guarded and never connected — the
             in-memory store stays the one used at runtime — see Program.cs. -->
        <ProjectReference Include="..\..\Integrations\CQRSharp.Redis\CQRSharp.Redis.csproj"/>
        <ProjectReference Include="..\..\Infrastructure\CQRSharp.Generators\CQRSharp.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
