<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <LangVersion>default</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <PackageOutputPath>$(MSBuildThisFileDirectory)..\.nupkgs</PackageOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('netstandard'))">
        <PublishAot>false</PublishAot>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '9.0.100'))">
        <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0.100'))">
        <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <Version>3.0.0</Version>
        <Authors>BisocM</Authors>
        <Company>BisocM</Company>
        <PackageTags>CQRS;CQRSharp</PackageTags>
        <Title>A lightweight, extensible, and attribute-driven CQRS framework for .NET applications (Abstractions).</Title>
        <Description>Shared contracts for CQRSharp, including marker interfaces, pipeline attribute contracts, validation and exception hook abstractions, and outbox interfaces.</Description>
        <PackageProjectUrl>https://cqrsharp.bisocm.org</PackageProjectUrl>
        <RepositoryUrl>https://github.com/BisocM/CQRSharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageIcon>CQRSharp_Icon.png</PackageIcon>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReleaseNotes>
            Version 3.0.0. Breaking changes: removed SensitiveData attribute and updated request metadata.
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\..\CQRSharp_Icon.png" Pack="true" PackagePath="\"/>
        <None Include="..\..\..\LICENSE" Pack="true" PackagePath="\"/>
        <None Include="..\..\..\NUGET_README.txt" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!--
        netstandard2.0 lacks IAsyncDisposable / IAsyncEnumerable in the BCL; this polyfill supplies them.
        net8.0+ have these in-box, so the reference is scoped to netstandard2.0 only. (Previously these
        types arrived transitively via an unused Microsoft.Extensions.DependencyInjection.Abstractions ref.)
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.2"/>
    </ItemGroup>

</Project>
