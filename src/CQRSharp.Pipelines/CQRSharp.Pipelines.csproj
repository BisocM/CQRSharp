<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(CQRSharpTargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Turns on the trim, AOT and single-file analyzers, whose warnings the -warnaserror gate makes errors. -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <PackageTags>CQRS;CQRSharp;Pipelines;Resilience;RateLimiting</PackageTags>
        <Title>The pipeline behaviors and fluent builder of CQRSharp.</Title>
        <Description>The pipeline behaviors of CQRSharp (validation, exception handling, logging, rate limiting, resilience, timeouts, idempotency with result replay, and the unit of work) and ICqrsBuilder, the fluent builder AddCqrsGenerated(b => ...) configures, including the outbox and idempotency store choice. The builder registers validation and exception handling by default; every other behavior runs only when its verb is called.</Description>
        <PackageReleaseNotes>
            Version 5.1.0. A notification scheduled inside a transactional request is stored with the unit of work's commit like any other.
            See https://github.com/BisocM/CQRSharp/blob/v$(Version)/CHANGELOG.md for the full notes; upgrading from 5.0 needs no code or schema change.
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CQRSharp.Core\CQRSharp.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The optional-behavior registration extensions are internal (the fluent builder is the public lane); the
             test project exercises them directly as white-box coverage. -->
        <InternalsVisibleTo Include="CQRSharp.Tests"/>
    </ItemGroup>

</Project>
