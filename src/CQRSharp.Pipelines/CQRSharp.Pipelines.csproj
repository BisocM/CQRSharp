<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Trim + AOT + single-file analyzers so any AOT-hostile pattern (reflection, dynamic codegen) is a build
             warning here, which the solution's -warnaserror gate promotes to an error. -->
        <EnableAotAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableAotAnalyzer>
        <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '9.0.100'))">
        <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0.100'))">
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <PackageTags>CQRS;CQRSharp;Pipelines;Resilience;RateLimiting</PackageTags>
        <Title>Optional Pipeline Behaviors for CQRSharp</Title>
        <Description>Optional, opt-in pipeline behaviors for CQRSharp — validation, unit of work, resilience/retries, timeouts, rate limiting, idempotency, and logging — plus a one-call pipeline-pack registration for sensible defaults.</Description>
        <PackageReleaseNotes>
            Version 5.0.0. A command that returns a failed CommandResult now rolls back its unit of work and releases its idempotency claim (UnitOfWorkOptions.RollbackOnFailedResult opts out). Streaming requests get idempotency enforcement. Only caller cancellation is terminal for retries; DuplicateRequestException is never retried. Behavior registration is idempotent. Breaking: the authoring surface is flattened to two namespaces, CQRSharp and CQRSharp.Pipelines (replace your CQRSharp.Abstractions.* / CQRSharp.Core.* usings; the CQRSharp meta-package applies both as global usings). See CHANGELOG.md for the full list.
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CQRSharp.Core\CQRSharp.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.2"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The optional-behavior registration extensions are internal (the fluent builder is the public lane); the
             test project exercises them directly as white-box coverage. -->
        <InternalsVisibleTo Include="CQRSharp.Tests"/>
    </ItemGroup>

</Project>
