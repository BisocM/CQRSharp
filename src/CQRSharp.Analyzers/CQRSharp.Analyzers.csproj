<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <!-- This Roslyn component builds as a (build-order) dependency of CQRSharp.Abstractions, so it can be pulled
             into a Native-AOT publish of a consumer. netstandard2.0 has no AOT; force PublishAot off (TreatAsLocalProperty
             lets this win over a global -p:PublishAot=true) so the consumer's AOT publish doesn't fail with NETSDK1207. -->
        <PublishAot>false</PublishAot>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>CQRSharp.Analyzers</RootNamespace>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <!-- Shipped embedded in CQRSharp.Abstractions' analyzers/dotnet/cs, not as a standalone package. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" VersionOverride="9.0.20" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md"/>
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
    </ItemGroup>

    <!-- The framework-type table is shared, verbatim, with CQRSharp.Generators (source-linked, not a reference, so
         neither Roslyn component takes a dependency on the other). -->
    <ItemGroup>
        <Compile Include="..\Shared\CqrsKnownSymbols.cs" Link="Shared\CqrsKnownSymbols.cs"/>
    </ItemGroup>

</Project>
