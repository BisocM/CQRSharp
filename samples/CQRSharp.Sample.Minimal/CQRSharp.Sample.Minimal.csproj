<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The smallest end-to-end CQRSharp app: register, send one request, print the result. docs/getting-started.md
        mirrors Program.cs so the page references a real, compiling file rather than assembled fragments. Uses
        ProjectReferences (and so imports the CQRSharp namespaces explicitly); with the CQRSharp meta-package those
        usings are applied automatically.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>CQRSharp.Sample.Minimal</RootNamespace>
        <TargetFramework>net8.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CQRSharp.Core\CQRSharp.Core.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.Pipelines\CQRSharp.Pipelines.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.Generators\CQRSharp.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
