<Project Sdk="Microsoft.NET.Sdk">

    <!--
        A second assembly in the CQRSharp.Tests reference graph, used to prove multi-assembly support. The generator runs
        here as in any CQRSharp assembly and emits this assembly's own uniquely-namespaced module, its
        [CqrsGeneratedModule] marker and its own internal AddCqrsGenerated, which the host never calls: the host's
        AddCqrsGenerated wires this module through the reference graph. The handlers are deliberately INTERNAL - the host
        cannot name them, yet they are registered because this assembly's own module registers them. For a request both
        assemblies handle (SharedCommand), the host's module registers last and wins.
    -->
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>default</LangVersion>
        <TargetFrameworks>$(CQRSharpTargetFrameworks)</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CQRSharp.Core\CQRSharp.Core.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.Generators\CQRSharp.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
