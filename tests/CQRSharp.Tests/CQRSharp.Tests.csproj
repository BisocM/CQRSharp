<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>default</LangVersion>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <!-- The analyzer/generator diagnostics are exercised by unit tests; suppress them on this project's own code.
             CQRGEN006 fires on the intentionally-private test handler fixtures (which are registered manually). -->
        <NoWarn>$(NoWarn);CQRA001;CQRA003;CQRA004;CQRA005;CQRA006;CQRA007;CQRGEN006</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '9.0.100'))">
        <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0.100'))">
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
        <!-- Workspaces APIs (Document/Project/AdhocWorkspace/CodeAction) for exercising code-fix providers in-test. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces"/>
        <!-- FakeTimeProvider drives the clock seam deterministically in timing tests (no real Task.Delay). -->
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
        <!-- In-memory TestServer for the CQRSharp.AspNetCore integration tests. TestHost must match the shared
             framework's major: the 8.0 response PipeWriter lacks UnflushedBytes, which System.Text.Json 9+ requires. -->
        <PackageReference Include="Microsoft.AspNetCore.TestHost" Condition="'$(TargetFramework)' == 'net8.0'"/>
        <PackageReference Include="Microsoft.AspNetCore.TestHost" Condition="'$(TargetFramework)' == 'net9.0'"/>
        <PackageReference Include="Microsoft.AspNetCore.TestHost" Condition="'$(TargetFramework)' == 'net10.0'"/>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="StackExchange.Redis"/>
        <!-- EF Core Sqlite pulls the SQLitePCLRaw e_sqlite3 native lib in transitively for the EF outbox-store tests;
             pin the newest available bundle. The remaining advisory is a SQLite-native CVE with no patched release yet,
             unreachable here (in-memory test databases, no untrusted SQL), and it ships in no package — only the EF
             tests reference Sqlite. It is suppressed surgically by id below so the audit stays fully active otherwise. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3"/>
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q"/>
        <PackageReference Include="Moq"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.console">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CQRSharp.Core\CQRSharp.Core.csproj"/>
        <!-- Referenced both as an analyzer (so it runs on this project) and for compile (so the incremental-caching
             test can drive the generator directly via CSharpGeneratorDriver). -->
        <ProjectReference Include="..\..\src\CQRSharp.Generators\CQRSharp.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="true"/>
        <ProjectReference Include="..\..\src\CQRSharp.Pipelines\CQRSharp.Pipelines.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.Analyzers\CQRSharp.Analyzers.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.Testing\CQRSharp.Testing.csproj"/>
        <!-- A second handler-bearing assembly, referenced to exercise CQRSharp's multi-assembly support: its module is
             wired by this assembly's AddCqrsGenerated (see MultiAssemblyTests). -->
        <ProjectReference Include="..\CQRSharp.Tests.ExternalModule\CQRSharp.Tests.ExternalModule.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.EntityFrameworkCore\CQRSharp.EntityFrameworkCore.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.Redis\CQRSharp.Redis.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.FluentValidation\CQRSharp.FluentValidation.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.AspNetCore\CQRSharp.AspNetCore.csproj"/>
    </ItemGroup>

    <!-- The shared well-known-type resolver, source-linked so the guard test exercises the exact code the generator
         and analyzers run (the .editorconfig beside the file keeps its neutral namespace intact). -->
    <ItemGroup>
        <Compile Include="..\..\src\Shared\CqrsKnownSymbols.cs" Link="Shared\CqrsKnownSymbols.cs"/>
    </ItemGroup>

</Project>
