<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>default</LangVersion>
        <!-- xUnit v3 test projects are Microsoft.Testing.Platform executables. Declared here, not only by the xUnit
             package, because dotnet test discovers test projects from the multi-targeting (outer) evaluation, which does
             not see the per-framework package props. -->
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
        <TargetFrameworks>$(CQRSharpTargetFrameworks)</TargetFrameworks>
        <!-- CQRGEN006 (a handler the generator cannot register) fires on the deliberately private nested handler and
             validator fixtures, which the tests register by hand. -->
        <NoWarn>$(NoWarn);CQRGEN006</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
        <!-- Workspaces APIs (Document/Project/AdhocWorkspace/CodeAction) for exercising code-fix providers in-test. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces"/>
        <!-- FakeTimeProvider drives the clock seam deterministically in timing tests (no real Task.Delay). -->
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
        <!-- The EF Core stores' entity types in contexts that use lazy-loading and change-tracking proxies. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies"/>
        <!-- The EF Core stores against the providers they run on in production. The databases come from Testcontainers
             (Docker) or from CQRSHARP_TEST_POSTGRES / CQRSHARP_TEST_SQLSERVER connection strings; without either the
             provider tests skip. -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer"/>
        <PackageReference Include="Microsoft.Data.SqlClient"/>
        <PackageReference Include="Testcontainers.PostgreSql"/>
        <PackageReference Include="Testcontainers.MsSql"/>
        <!-- In-memory TestServer for the CQRSharp.AspNetCore integration tests (versioned per framework centrally). -->
        <PackageReference Include="Microsoft.AspNetCore.TestHost"/>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <!-- The Redis stores against a real server: CQRSHARP_TEST_REDIS (CI's service container) or a Testcontainers
             Redis (Docker); without either the Redis tests skip. -->
        <PackageReference Include="StackExchange.Redis"/>
        <PackageReference Include="Testcontainers.Redis"/>
        <!-- EF Core Sqlite brings the SQLitePCLRaw e_sqlite3 native library in transitively, at a version with a
             vulnerable SQLite (GHSA-2m69-gcr7-jv3q); the direct reference lifts it to a patched bundle. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3"/>
        <PackageReference Include="Moq"/>
        <PackageReference Include="xunit.v3"/>
        <!-- Microsoft.Testing.Platform extensions for CI: a hang dump with a timeout (a stuck test fails the run instead
             of hanging it), TRX results, and Cobertura coverage. -->
        <PackageReference Include="Microsoft.Testing.Extensions.HangDump"/>
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport"/>
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CQRSharp.Core\CQRSharp.Core.csproj"/>
        <!-- Referenced both as an analyzer (so it runs on this project) and for compile (so the incremental-caching
             test can drive the generator directly via CSharpGeneratorDriver). -->
        <ProjectReference Include="..\..\src\CQRSharp.Generators\CQRSharp.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="true"/>
        <ProjectReference Include="..\..\src\CQRSharp.Pipelines\CQRSharp.Pipelines.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.Analyzers\CQRSharp.Analyzers.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.Testing\CQRSharp.Testing.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.Testing.Xunit.V3\CQRSharp.Testing.Xunit.V3.csproj"/>
        <!-- A second handler-bearing assembly, referenced to exercise CQRSharp's multi-assembly support: its module is
             wired by this assembly's AddCqrsGenerated (see MultiAssemblyCompositionTests). -->
        <ProjectReference Include="..\CQRSharp.Tests.ExternalModule\CQRSharp.Tests.ExternalModule.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.EntityFrameworkCore\CQRSharp.EntityFrameworkCore.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.Redis\CQRSharp.Redis.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.FluentValidation\CQRSharp.FluentValidation.csproj"/>
        <ProjectReference Include="..\..\src\CQRSharp.AspNetCore\CQRSharp.AspNetCore.csproj"/>
    </ItemGroup>

    <!-- The shared framework-type table, source-linked so its guard test exercises the exact code the generator and
         analyzers run (the .editorconfig beside the file keeps its neutral namespace intact). -->
    <ItemGroup>
        <Compile Include="..\..\src\Shared\CqrsKnownSymbols.cs" Link="Shared\CqrsKnownSymbols.cs"/>
    </ItemGroup>

</Project>
