<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>CQRSharp.Sample</RootNamespace>
        <LangVersion>default</LangVersion>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <PublishAot>true</PublishAot>
        <RunAnalyzers>true</RunAnalyzers>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CQRSharp" Version="2.2.6" />
        <PackageReference Include="CQRSharp.Generators" Version="2.2.6" />
        <PackageReference Include="CQRSharp.Shared" Version="2.2.6" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.2"/>
    </ItemGroup>
 
</Project>