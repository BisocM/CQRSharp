<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>CQRSharp.Sample</RootNamespace>
        <LangVersion>default</LangVersion>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <PublishAot>true</PublishAot>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.2" />
        <ProjectReference Include="..\CQRSharp.Generator\CQRSharp.Generator.csproj" OutputItemType="Analyzer" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CQRSharp.Kafka\CQRSharp.Kafka.csproj"/>
        <ProjectReference Include="..\CQRSharp\CQRSharp.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <TrimmerRootDescriptor Include="AoT_Linker.xml" />
    </ItemGroup>

</Project>
